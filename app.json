{
  "expo": {
    "name": "FreshCart",
    "slug": "FreshCart",
    "version": "1.0.0",
    "scheme": "freshcart",
    "orientation": "portrait",
    "icon": "./assets/freshcarticon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/freshcarticon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.freshcart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/freshcarticon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FreshCart to access your photos to upload product images.",
          "cameraPermission": "The app accesses your camera to let you share photos with your friends."
        }
      ],
      [
        "expo-file-system",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "The app accesses your camera to let you share photos with your friends."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e61cc4ca-5cfe-4b78-9831-a8041d56675f"
      }
    },
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/e61cc4ca-5cfe-4b78-9831-a8041d56675f"
    }
  }
}
